use std/test
use std/math
use std/array

print "Running Standard Library Tests..."

# Math tests
assert_eq(factorial(5), 120)
assert_eq(gcd(48, 18), 6)

# Array tests
func double(x):
    return x * 2

func is_even(x):
    return x % 2 == 0

func add(a, b):
    return a + b

lst : [1, 2, 3, 4]
assert_eq(map(lst, double), [2, 4, 6, 8])
assert_eq(filter(lst, is_even), [2, 4])
assert_eq(reduce(lst, add, 0), 10)

print "All tests passed successfully!"
